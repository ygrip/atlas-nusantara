{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusantara-atlas",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/published/*"]
  },
  "routes": [{ "pattern": "nusantara.readynaz.com", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nusantara-atlas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "HOT_DATA", "bucket_name": "nusantara-hot-data" }],
  "ratelimits": [
    { "name": "COLD_REQUEST_LIMITER", "namespace_id": "73001", "simple": { "limit": 10, "period": 60 } },
    { "name": "COLD_EXPORT_LIMITER", "namespace_id": "73002", "simple": { "limit": 2, "period": 60 } },
    { "name": "COLD_BUDGET_LIMITER", "namespace_id": "73003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "LOCAL_HOT_DATA_FALLBACK": "false",
    "TURNSTILE_HOSTNAMES": "nusantara.readynaz.com",
    "COLD_DAILY_DOWNLOAD_LIMIT": "20",
    "APPROVED_SOURCE_IDS": "",
    "BMKG_EARTHQUAKES_LICENSE": "",
    "BMKG_EARTHQUAKES_LICENSE_URL": "",
    "BMKG_EARTHQUAKES_REVIEWED_BY": "",
    "BMKG_EARTHQUAKES_REVIEWED_AT": "",
    "BMKG_NOWCAST_LICENSE": "",
    "BMKG_NOWCAST_LICENSE_URL": "",
    "BMKG_NOWCAST_REVIEWED_BY": "",
    "BMKG_NOWCAST_REVIEWED_AT": ""
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
