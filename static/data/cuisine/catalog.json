{"schemaVersion":1,"countryCode":"ID","fetchedAt":"2026-10-28T00:00:00.000Z","sources":[{"url":"https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia","role":"province list seed","license":"CC-BY-SA-4.0"}],"caution":"Small editorial starter only. Run node scripts/cuisine/build.mjs to replace this with the full Wikipedia index and 320-recipe MIT dataset. Starter cooking instructions are independently written, untested examples.","dishes":[{"id":"arsik","name":"Arsik","provinceCodes":["12"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"ayam-betutu","name":"Ayam Betutu","provinceCodes":["51"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["1 ekor ayam bersih","8 siung bawang merah","5 siung bawang putih","cabai, kunyit, jahe, kencur, dan lengkuas","2 batang serai","daun jeruk","garam dan minyak"],"steps":["Haluskan bumbu, tumis sebentar, lalu dinginkan.","Balurkan bumbu ke seluruh permukaan dan rongga ayam.","Bungkus ayam dengan daun pisang atau tutup rapat dalam loyang.","Kukus atau panggang perlahan hingga daging matang sampai ke bagian terdalam; sajikan dengan bumbu."],"timeMinutes":160,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"ayam-tangkap","name":"Ayam Tangkap","provinceCodes":["11"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"bika-ambon","name":"Bika Ambon","provinceCodes":["12"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"dendeng-balado","name":"Dendeng Balado","provinceCodes":["13"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"gudeg","name":"Gudeg","provinceCodes":["34"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["750 g nangka muda","600 ml santan","120 g gula merah","5 siung bawang merah","4 siung bawang putih","2 lembar daun salam","lengkuas dan garam"],"steps":["Rebus nangka muda sampai agak lunak lalu tiriskan.","Haluskan bawang dan garam; masukkan ke panci bersama nangka, santan, gula merah, salam, dan lengkuas.","Masak dengan api sangat kecil hingga nangka empuk dan kuah berkurang.","Aduk sesekali dan sajikan bersama nasi dan lauk pendamping."],"timeMinutes":180,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"gulai-tempoyak","name":"Gulai Tempoyak","provinceCodes":["16"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"kanji-rumbi","name":"Kanji Rumbi","provinceCodes":["11"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"lamang-tapai","name":"Lamang Tapai","provinceCodes":["13"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"mie-aceh","name":"Mie Aceh","provinceCodes":["11"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["300 g mie kuning tebal","150 g daging ayam atau udang","3 siung bawang putih","4 siung bawang merah","2 sdm bubuk kari","1 buah tomat","kol dan daun bawang","200 ml kaldu","kecap dan garam secukupnya"],"steps":["Tumis irisan bawang dengan bubuk kari hingga harum.","Masukkan ayam atau udang, masak sampai matang, lalu tambahkan tomat dan kol.","Tuang kaldu dan bumbui dengan kecap serta garam.","Masukkan mie, aduk hingga terlapisi bumbu dan cairan berkurang; taburi daun bawang."],"timeMinutes":35,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"mie-gomak","name":"Mie Gomak","provinceCodes":["12"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["250 g mie lidi","200 ml santan","3 siung bawang merah","2 siung bawang putih","cabai sesuai selera","andaliman secukupnya","daun bawang dan garam"],"steps":["Rebus mie lidi sampai empuk, tiriskan.","Haluskan bawang dan cabai; tumis hingga harum.","Tuang santan perlahan dan bumbui dengan garam serta andaliman.","Masukkan mie dan aduk perlahan sampai hangat dan bumbu merata."],"timeMinutes":35,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"mie-lendir","name":"Mie Lendir","provinceCodes":["21"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"nasi-gemuk","name":"Nasi Gemuk","provinceCodes":["15"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"papeda","name":"Papeda","provinceCodes":["91"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["150 g tepung sagu","500 ml air","sedikit garam"],"steps":["Larutkan sagu dengan sebagian air dingin hingga tidak menggumpal.","Didihkan sisa air dengan sedikit garam.","Tuang air panas perlahan ke larutan sagu sambil mengaduk cepat.","Aduk sampai bening dan kental, lalu sajikan segera bersama lauk berkuah."],"timeMinutes":15,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"pempek-kapal-selam","name":"Pempek Kapal Selam","provinceCodes":["16"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["300 g ikan tenggiri giling","200 g tepung tapioka","120 ml air dingin","2 butir telur","garam secukupnya","gula merah, cuka, bawang putih, dan cabai untuk cuko"],"steps":["Campur ikan giling, air dingin, dan garam sampai rata, lalu masukkan tapioka sedikit demi sedikit.","Bentuk adonan menjadi kantong, isi dengan telur, dan tutup rapat.","Rebus dalam air mendidih perlahan hingga pempek matang, lalu tiriskan.","Masak gula merah, cuka, bawang putih, dan cabai menjadi kuah cuko; sajikan bersama pempek yang digoreng sebentar."],"timeMinutes":65,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"pendap","name":"Pendap","provinceCodes":["17"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"rawon","name":"Rawon","provinceCodes":["35"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["500 g daging sapi untuk semur","4 buah keluak matang, ambil isinya","5 siung bawang merah","3 siung bawang putih","2 batang serai","daun jeruk dan lengkuas","1,5 liter air","garam"],"steps":["Rebus daging sapi sampai cukup empuk lalu potong sesuai selera; sisihkan kaldunya.","Haluskan isi keluak bersama bawang, kemudian tumis dengan serai, daun jeruk, dan lengkuas.","Masukkan tumisan bumbu ke kaldu dan tambahkan daging.","Didihkan perlahan hingga daging empuk dan kuah berwarna gelap; sesuaikan garam."],"timeMinutes":110,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"rendang","name":"Rendang","provinceCodes":["13"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["1 kg daging sapi, potong besar","1 liter santan kental","8 siung bawang merah","5 siung bawang putih","cabai merah sesuai selera","2 batang serai, memarkan","lengkuas dan daun jeruk","garam secukupnya"],"steps":["Haluskan bawang merah, bawang putih, dan cabai, lalu tumis bersama serai, lengkuas, serta daun jeruk hingga harum.","Masukkan daging sapi dan santan, aduk perlahan sampai mulai mendidih.","Masak dengan api kecil selama beberapa jam, sesekali aduk agar santan tidak gosong.","Lanjutkan hingga bumbu mengental dan menyelimuti daging; sesuaikan garam sebelum disajikan."],"timeMinutes":200,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"sate-padang","name":"Sate Padang","provinceCodes":["13"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"seruit","name":"Seruit","provinceCodes":["18"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"soto-medan","name":"Soto Medan","provinceCodes":["12"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"soto-padang","name":"Soto Padang","provinceCodes":["13"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["300 g daging sapi","1 liter kaldu sapi","3 siung bawang putih","4 siung bawang merah","jahe dan serai","bihun rebus","perkedel kentang","daun bawang","garam secukupnya"],"steps":["Rebus daging hingga empuk; simpan kaldunya.","Iris daging tipis dan goreng sebentar hingga permukaannya agak kering.","Tumis bawang, jahe, dan serai; masukkan ke kaldu lalu didihkan kembali.","Susun bihun, daging, dan perkedel dalam mangkuk; siram kuah panas dan taburi daun bawang."],"timeMinutes":90,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}},{"id":"timphan","name":"Timphan","provinceCodes":["11"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":null},{"id":"tinutuan","name":"Tinutuan","provinceCodes":["71"],"category":"food","wikipediaListed":false,"image":null,"sourceUrls":["https://id.wikipedia.org/wiki/Daftar_masakan_Indonesia"],"localization":{"id":"original"},"recipe":{"ingredients":["150 g beras","1 buah jagung, pipil","150 g labu kuning","1 ubi jalar kecil","1 ikat kangkung","1 ikat bayam","garam dan daun kemangi"],"steps":["Masak beras dengan air lebih banyak dari bubur biasa.","Masukkan jagung, ubi, dan labu; masak sampai sayuran lunak dan bubur mengental.","Tambahkan kangkung, bayam, serta garam menjelang selesai.","Aduk sebentar sampai daun layu dan sajikan hangat bersama daun kemangi."],"timeMinutes":60,"difficulty":null,"sourceRegion":null,"language":"id","sourceUrl":"https://github.com/ygrip/atlas-nusantara","license":"Original editorial sample","translationStatus":"original"}}],"recipes":10,"images":0,"listedOnly":14,"imageEnrichment":{"considered":0,"licensedImages":0,"failedBatches":0}}
