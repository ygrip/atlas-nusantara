    {
      "id": "es-teler",
      "name": "Es Teler",
      "provinceCodes": [
        "31"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Es_Teler",
      "recipe": {
        "ingredients": [
          "2 buah alpukat mentega, keruk dagingnya",
          "200 gram kelapa muda, keruk panjang",
          "150 gram nangka matang, potong dadu",
          "100 gram cincau hitam, potong dadu",
          "300 ml air kelapa muda",
          "200 ml santan kental dari 1/2 butir kelapa",
          "5 sendok makan kental manis putih",
          "100 ml sirup cocopandan",
          "1/2 sendok teh garam",
          "es batu secukupnya"
        ],
        "steps": [
          "Keruk daging alpukat dan kelapa muda, potong nangka serta cincau dadu. Sisihkan dalam wadah.",
          "Campur santan kental, air kelapa, kental manis, sirup cocopandan, dan garam. Aduk sampai gula larut, koreksi rasa.",
          "Tata alpukat, kelapa muda, nangka, dan cincau ke dalam gelas saji. Tambahkan es batu sampai hampir penuh.",
          "Tuang campuran santan dan sirup ke tiap gelas sampai buah terendam. Aduk perlahan.",
          "Sajikan segera selagi dingin."
        ],
        "category": "minuman",
        "difficulty": "mudah",
        "timeMinutes": 30,
        "language": "id",
