    {
      "id": "es-kacang-merah",
      "name": "Es Kacang merah",
      "provinceCodes": [
        "16",
        "71"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Es_Kacang_merah",
      "recipe": {
        "ingredients": [
          "250 gram kacang merah kering",
          "1 liter air untuk merebus",
          "150 gram gula merah, sisir halus",
          "2 sdm gula pasir",
          "2 lembar daun pandan, simpulkan",
          "1/2 sdt garam",
          "200 ml santan kental dari 1/2 butir kelapa",
          "es batu secukupnya",
          "100 ml susu kental manis"
        ],
        "steps": [
          "Rendam kacang merah minimal 3 jam atau semalaman, lalu cuci bersih dan tiriskan.",
          "Rebus kacang merah dengan 1 liter air menggunakan api sedang sampai empuk, sekitar 45 menit.",
          "Masukkan gula merah, gula pasir, daun pandan, dan garam. Aduk rata, masak 10 menit sampai gula larut dan kacang mulai pecah.",
          "Kecilkan api, tuang santan sambil diaduk pelan. Masak sampai mendidih sekali, angkat dan biarkan hangat.",
          "Isi gelas dengan es batu, tuang kacang merah beserta kuahnya, tambahkan susu kental manis.",
          "Sajikan segera selagi dingin."
        ],
