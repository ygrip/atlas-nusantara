    {
      "id": "cakalang-fufu",
      "name": "Cakalang Fufu",
      "provinceCodes": [
        "71"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Cakalang_Fufu",
      "recipe": {
        "ingredients": [
          "500 gram cakalang fufu (ikan cakalang asap)",
          "6 butir bawang merah, iris tipis",
          "3 siung bawang putih, iris tipis",
          "8 buah cabai rawit merah, iris serong",
          "2 buah tomat hijau, potong dadu",
          "1 batang serai, memarkan",
          "2 lembar daun jeruk, sobek",
          "1 sdm air asam jawa",
          "1 sdt garam",
          "1 sdt gula pasir",
          "3 sdm minyak goreng"
        ],
        "steps": [
          "Suwir-suwir kasar cakalang fufu, sisihkan.",
          "Panaskan minyak, tumis bawang merah dan bawang putih sampai layu dan harum.",
          "Masukkan cabai rawit, serai, dan daun jeruk. Tumis sampai cabai layu.",
          "Masukkan tomat hijau, aduk sampai sedikit layu.",
          "Tambahkan cakalang fufu suwir, aduk rata.",
          "Beri air asam jawa, garam, dan gula pasir. Masak dengan api kecil sambil diaduk sampai bumbu meresap dan cakalang agak kering.",
          "Angkat dan sajikan hangat dengan nasi putih."
        ],
