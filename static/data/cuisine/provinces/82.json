    {
      "id": "kohu-kohu",
      "name": "Kohu-kohu",
      "provinceCodes": [
        "82"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Kohu-kohu",
      "recipe": {
        "ingredients": [
          "250 gram cakalang asap (fufu), suwir-suwir",
          "200 gram kacang panjang (2 ikat), iris tipis serong",
          "150 gram kol, iris halus",
          "150 gram tauge, buang akarnya",
          "1 genggam daun kemangi",
          "150 gram kelapa parut (½ butir kelapa setengah tua)",
          "2 butir jeruk nipis, ambil airnya",
          "3 siung bawang merah, iris tipis",
          "5 buah cabai rawit merah, iris",
          "1 sendok makan kenari, sangrai lalu haluskan",
          "1 sendok teh garam"
        ],
        "steps": [
          "Siapkan semua sayuran: kacang panjang diiris tipis serong, kol diiris halus, tauge dibuang akarnya. Cuci bersih lalu tiriskan.",
          "Suwir-suwir cakalang asap, buang duri dan kulitnya.",
          "Campur kelapa parut dengan air jeruk nipis, garam, cabai rawit, bawang merah, dan kenari halus. Aduk rata.",
          "Masukkan kacang panjang, kol, tauge, dan cakalang suwir ke dalam campuran kelapa. Aduk sambil diremas-remas perlahan dengan tangan supaya bumbu meresap.",
          "Tambahkan daun kemangi, aduk perlahan. Diamkan 5–10 menit agar bumbu meresap.",
          "Sajikan dengan nasi hangat."
        ],
        "category": "makanan_utama",
        "difficulty": "mudah",
        "timeMinutes": 30,
        "language": "id",
        "status": "source",
        "sourceUrl": "https://huggingface.co/datasets/LorthGyu/indonesian-recipes"
