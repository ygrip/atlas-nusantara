    {
      "id": "sambal-andaliman",
      "name": "Sambal Andaliman",
      "provinceCodes": [
        "12"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Sambal_Andaliman",
      "recipe": {
        "ingredients": [
          "2 sdm andaliman",
          "15 buah cabai rawit merah",
          "5 butir bawang merah",
          "3 siung bawang putih",
          "1 sdt garam",
          "1/2 sdt gula pasir",
          "2 lembar daun jeruk, buang tulangnya",
          "4 sdm minyak goreng"
        ],
        "steps": [
          "Haluskan cabai rawit, bawang merah, bawang putih, andaliman, dan garam pakai cobek atau blender. Tidak perlu terlalu halus, tekstur kasar itu khas sambal andaliman.",
          "Panaskan minyak goreng di wajan, tumis bumbu halus bersama daun jeruk di atas api kecil.",
          "Tambahkan gula pasir, aduk rata. Masak sambil diaduk sampai sambal matang, harum, dan minyaknya keluar, sekitar 10 menit.",
          "Koreksi rasa, angkat. Sajikan sebagai pelengkap ikan bakar, ayam panggang, atau lalapan."
        ],
        "category": "makanan_pembuka",
        "difficulty": "mudah",
