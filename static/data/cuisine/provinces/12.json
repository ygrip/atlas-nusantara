    {
      "id": "babi-panggang-karo",
      "name": "Babi Panggang Karo",
      "provinceCodes": [
        "12"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Babi_Panggang_Karo",
      "recipe": {
        "ingredients": [
          "1 kg daging babi berlemak (pork belly), potong besar",
          "200 ml darah babi segar",
          "5 sdm air jeruk nipis",
          "10 butir bawang merah",
          "5 siung bawang putih",
          "6 buah cabai merah keriting",
          "1 sdt andaliman",
          "3 butir kemiri, sangrai",
          "2 cm jahe",
          "3 cm lengkuas, memarkan",
          "2 batang serai, memarkan",
          "1 sdt garam, 1 sdt gula merah sisir"
        ],
        "steps": [
          "Lumuri babi dengan garam, bakar/panggang di atas bara api sambil dibalik sampai setengah matang dan berwarna kecokelatan, lalu iris tipis-tipis.",
          "Haluskan bawang merah, bawang putih, cabai, andaliman, kemiri, jahe, dan sedikit garam sampai lembut.",
          "Campur darah babi dengan air jeruk nipis, aduk cepat supaya tidak menggumpal, sisihkan.",
          "Tumis bumbu halus dengan lengkuas dan serai sampai harum, masukkan darah babi sambil diaduk dengan api kecil.",
          "Tambahkan gula merah, masak sambil terus diaduk sampai saus mengental dan darah matang sempurna.",
          "Koreksi rasa, masukkan irisan babi panggang ke dalam saus, aduk rata sampai daging terselimuti bumbu.",
          "Angkat, sajikan hangat dengan nasi putih dan sayur segar."
        ],
        "category": "makanan_utama",
        "difficulty": "sedang",
        "timeMinutes": 90,
        "language": "id",
        "status": "source",
        "sourceUrl": "https://huggingface.co/datasets/LorthGyu/indonesian-recipes"
