    {
      "id": "mie-aceh",
      "name": "Mie Aceh",
      "provinceCodes": [
        "11"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Mie_Aceh",
      "recipe": {
        "ingredients": [
          "500 gram mie basah kuning",
          "250 gram daging sapi, iris tipis",
          "bumbu halus: 6 bawang merah, 4 siung bawang putih, 3 cabai merah besar, 10 cabai rawit, 3 kemiri sangrai, 1 sdt jintan sangrai, 1 sdt ketumbar, 2 cm lengkuas, 2 cm jahe, 1 sdt bubuk kari",
          "1 batang serai, memarkan",
          "2 lembar daun jeruk",
          "1 buah tomat, iris",
          "2 sdm kecap manis",
          "1 sdt garam",
          "1 sdt gula pasir",
          "1/2 sdt merica",
          "3 sdm minyak goreng",
          "100 ml air"
        ],
        "steps": [
          "Panaskan minyak, tumis bumbu halus bersama serai dan daun jeruk sampai harum dan matang.",
          "Masukkan daging sapi, aduk sampai berubah warna.",
          "Tambahkan tomat, kecap manis, garam, gula, dan merica. Tuang air, masak dengan api kecil sampai daging empuk dan bumbu meresap.",
          "Masukkan mie kuning, aduk rata dengan api besar selama 3-5 menit sampai mie terlumuri bumbu dan sedikit kering.",
          "Angkat, sajikan hangat dengan acar timun-wortel, bawang goreng, dan emping."
        ],
        "category": "makanan_utama",
        "difficulty": "sedang",
        "timeMinutes": 60,
        "language": "id",
        "status": "source",
