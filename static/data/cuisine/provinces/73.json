    {
      "id": "coto-makassar",
      "name": "Coto Makassar",
      "provinceCodes": [
        "73"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Coto_Makassar",
      "recipe": {
        "ingredients": [
          "500 gram daging sapi (sengkel), potong dadu",
          "250 gram babat/hati sapi, rebus, potong-potong",
          "150 gram kacang tanah goreng, haluskan",
          "bumbu halus: 8 butir bawang merah, 6 siung bawang putih, 4 butir kemiri, 1 sdt ketumbar, 1 sdt jintan",
          "2 batang serai, memarkan",
          "3 cm lengkuas, memarkan",
          "3 lembar daun jeruk",
          "1 sdm tauco",
          "1,5 liter air",
          "1 sdm garam",
          "1 sdt gula pasir",
          "3 sdm minyak goreng"
        ],
        "steps": [
          "Rebus daging sapi bersama babat dalam 1,5 liter air sampai empuk sekitar 60 menit. Buang busa yang mengapung, angkat daging, sisihkan air kaldunya.",
          "Haluskan bawang merah, bawang putih, kemiri, ketumbar, dan jintan.",
          "Tumis bumbu halus bersama serai, lengkuas, dan daun jeruk sampai harum.",
          "Masukkan tauco, aduk rata sebentar.",
          "Tuang tumisan bumbu dan kacang tanah halus ke dalam kaldu, didihkan dengan api kecil.",
          "Masukkan kembali daging dan babat, bumbui garam dan gula. Masak sampai kuah mengental dan bumbu meresap, sekitar 30 menit.",
          "Angkat, sajikan hangat dengan ketupat, bawang goreng, sambal tauco, dan perasan jeruk nipis."
        ],
        "category": "makanan_utama",
        "difficulty": "sedang",
        "timeMinutes": 120,
        "language": "id",
        "status": "source",
