    {
      "id": "gulai-ikan-patin",
      "name": "Gulai ikan patin",
      "provinceCodes": [
        "14"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Gulai_ikan_patin",
      "recipe": {
        "ingredients": [
          "500 gram ikan patin, potong 3 bagian",
          "1 liter santan kental dari 1 butir kelapa",
          "1 buah jeruk nipis",
          "3 lembar daun kunyit, simpulkan",
          "3 lembar daun jeruk",
          "2 batang serai, memarkan",
          "3 cm lengkuas, memarkan",
          "5 buah asam kandis",
          "2 sendok makan minyak goreng",
          "bumbu halus: 8 bawang merah, 5 bawang putih, 3 cabai merah keriting, 2 cm kunyit, 2 cm jahe, 1 sendok teh garam"
        ],
        "steps": [
          "Lumuri ikan patin dengan air jeruk nipis dan sedikit garam, diamkan 10 menit, lalu bilas bersih.",
          "Panaskan minyak goreng, tumis bumbu halus bersama daun kunyit, daun jeruk, serai, dan lengkuas sampai harum dan bumbu benar-benar matang.",
          "Tuang santan sedikit demi sedikit sambil diaduk, masak dengan api kecil sambil terus diaduk sampai santan mendidih dan tidak pecah.",
          "Masukkan ikan patin dan asam kandis, masak dengan api kecil selama 15-20 menit sampai kuah sedikit mengental dan bumbu meresap.",
          "Koreksi rasa, angkat, dan sajikan hangat dengan nasi putih."
        ],
        "category": "makanan_utama",
        "difficulty": "sedang",
        "timeMinutes": 60,
        "language": "id",
        "status": "source",
        "sourceUrl": "https://huggingface.co/datasets/LorthGyu/indonesian-recipes"
      },
