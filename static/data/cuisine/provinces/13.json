    {
      "id": "dendeng-batokok",
      "name": "Dendeng batokok",
      "provinceCodes": [
        "13"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Dendeng_batokok",
      "recipe": {
        "ingredients": [
          "500 gram daging sapi, iris tipis melebar",
          "6 siung bawang merah",
          "4 siung bawang putih",
          "3 butir kemiri, sangrai",
          "1 sdt ketumbar bubuk",
          "2 cm kunyit, bakar",
          "1 sdt garam",
          "1 batang serai, memarkan",
          "2 lembar daun salam",
          "2 cm lengkuas, geprek",
          "250 ml air",
          "minyak goreng secukupnya"
        ],
        "steps": [
          "Haluskan bawang merah, bawang putih, kemiri, ketumbar, kunyit, dan garam.",
          "Rebus daging bersama bumbu halus, daun salam, serai, lengkuas, dan air sampai empuk dan bumbu meresap, sekitar 40 menit.",
          "Angkat daging, tiriskan, lalu pipihkan dengan cara dipukul-pukul pakai ulekan hingga agak melebar.",
          "Panaskan minyak banyak, goreng daging dengan api sedang sampai kering dan kecokelatan.",
          "Angkat, tiriskan, sajikan hangat dengan sambalado hijau."
        ],
        "category": "makanan_utama",
        "difficulty": "sedang",
        "timeMinutes": 60,
        "language": "id",
        "status": "source",
