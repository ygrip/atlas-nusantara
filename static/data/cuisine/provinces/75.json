    {
      "id": "binte-biluhuta",
      "name": "Binte Biluhuta",
      "provinceCodes": [
        "75"
      ],
      "originStatus": "wikipedia-listed",
      "articleUrl": "https://id.wikipedia.org/wiki/Binte_Biluhuta",
      "recipe": {
        "ingredients": [
          "350 gram jagung manis pipil",
          "150 gram ikan cakalang suwir (rebus/bakar)",
          "200 gram kelapa parut",
          "1,5 liter air",
          "6 butir bawang merah, iris",
          "3 siung bawang putih, iris",
          "5 buah cabai rawit, iris",
          "2 batang daun bawang, iris halus",
          "30 gram daun kemangi",
          "1 buah jeruk nipis, ambil airnya",
          "1 sdt garam",
          "1/2 sdt gula pasir"
        ],
        "steps": [
          "Rebus air sampai mendidih, masukkan jagung pipil, masak sekitar 10 menit sampai jagung empuk.",
          "Masukkan ikan cakalang suwir, garam, dan gula. Aduk rata, masak 5 menit.",
          "Tambahkan bawang merah, bawang putih, dan cabai rawit iris. Aduk, matikan api.",
          "Masukkan kelapa parut, daun kemangi, dan daun bawang. Aduk sebentar sampai kuah agak kental.",
          "Koreksi rasa. Sajikan hangat dengan perasan air jeruk nipis."
        ],
        "category": "makanan_utama",
        "difficulty": "mudah",
        "timeMinutes": 45,
        "language": "id",
        "status": "source",
