{
  "name": "nusantara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run compile:locales && vite build && node scripts/prepare-static.mjs && node scripts/export-error-page.mjs",
    "preview": "vite preview",
    "check": "npm run compile:locales && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:locales": "node scripts/check-locales.mjs",
    "import:regions": "node scripts/import-regions.mjs",
    "compile:locales": "node scripts/compile-locales.mjs",
    "build:geometry": "node scripts/geo/build-geometry.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "build:population-regions": "node scripts/population/build-region-pyramids.mjs",
    "species:build": "node scripts/species/merge-species.mjs",
    "build:languages": "node scripts/languages/build-language-counts.mjs",
    "build:destinations": "node scripts/destinations/catalog-output.mjs static/data/destinations",
    "destinations:images:wikidata": "node scripts/destinations/discover-images.mjs",
    "destinations:images:wikipedia": "node scripts/destinations/search-wikipedia-images.mjs",
    "destinations:images:commons": "node scripts/destinations/fill-commons-photos.mjs",
    "destinations:images:queue": "node scripts/destinations/image-review-queue.mjs",
    "destinations:images:web": "node scripts/destinations/scrape-google-images.mjs",
    "destinations:images:web:apply": "node scripts/destinations/apply-google-images.mjs",
    "seed:hierarchy": "node scripts/geo/seed-hierarchy.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "node --experimental-strip-types --test tests/geo/*.test.mjs tests/i18n/*.test.mjs tests/push/*.test.mjs tests/push/*.test.ts tests/ingestion/*.test.ts tests/pipeline/*.test.mjs tests/cloudflare/*.test.ts tests/cloudflare/*.test.mjs tests/share/*.test.mjs tests/publication/*.test.mjs tests/places/*.test.mjs tests/species/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:worker": "npm run build && node tests/integration/worker.mjs",
    "worker:dev": "wrangler dev --local --test-scheduled --var LOCAL_HOT_DATA_FALLBACK:true",
    "worker:types": "wrangler types cloudflare/worker-configuration.d.ts --strict-vars false",
    "worker:check": "npm run worker:types && tsc --noEmit -p cloudflare/tsconfig.json",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "snapshot:hazards": "node --experimental-strip-types scripts/pipeline/run.mjs",
    "build:gazetteer": "node --experimental-strip-types scripts/pipeline/build-gazetteer-data.mjs",
    "data:bootstrap": "npm run build && node scripts/bootstrap-data.mjs",
    "push:dev": "node server/push-server.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.40.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "d3-geo": "^3.1.1",
    "mapshaper": "^0.7.98",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "chart.js": "^4.6.1",
    "fast-xml-parser": "^5.11.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-svelte": "^1.0.1",
    "three": "^0.180.0",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20261023.1": true
  }
}
