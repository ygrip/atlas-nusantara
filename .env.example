# Production hot data: public R2 CUSTOM domain + JSON caching rule + CORS (not r2.dev).
# Empty works only on loopback/local builds. Production requires the direct CDN origin.
VITE_PUBLIC_DATA_ORIGIN=
# Optional scheduled weather/earthquake snapshots. HTTPS public R2 custom origin with CORS.
# Without this, the map uses the visibly dated release snapshots bundled in static/data.
VITE_PUBLIC_SNAPSHOT_ORIGIN=
# Public Turnstile sitekey only. TURNSTILE_SECRET belongs in Worker secrets, never here.
VITE_TURNSTILE_SITE_KEY=

# Public build-time sponsor configuration. Disabled unless explicitly enabled.
VITE_SPONSOR_ENABLED=false
VITE_SPONSOR_TITLE=
VITE_SPONSOR_URL=
