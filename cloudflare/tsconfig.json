{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/lib/data/ingestion/**/*.ts", "../src/lib/atlas/code-upgrades.ts", "../tests/cloudflare/**/*.ts"]
}
